{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Atlas",
    "version":  "1.0.1",
    "identifier":  "app.atlas.launcher",
    "build":  {
                  "frontendDist":  "../ui"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Atlas",
                                    "width":  1400,
                                    "height":  860,
                                    "minWidth":  1000,
                                    "minHeight":  620,
                                    "center":  true,
                                    "decorations":  false,
                                    "backgroundColor":  "#171a21"
                                }
                            ],
                "security":  {
                                 "csp":  null,
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "**/*.jpg",
                                                                     "**/*.jpeg",
                                                                     "**/*.png",
                                                                     "**/*.webp",
                                                                     "**/*.gif",
                                                                     "**/*.bmp",
                                                                     "**/*.ico"
                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "publisher":  "Atlas",
                   "shortDescription":  "All your games in one place",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "installerIcon":  "icons/icon.ico",
                                                "headerImage":  "installer/header.bmp",
                                                "sidebarImage":  "installer/sidebar.bmp",
                                                "languages":  [
                                                                  "English"
                                                              ]
                                            }
                               },
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMkNCMzNGQjk0NEMxMUYKUldRZndVUzVQN01zdTBMTWdUL01YWkZhekgvalNCMTk4aWJRUFgzeUcrdzR6RG8yRlNkaW1zbjIK",
                                    "endpoints":  [
                                                      "https://github.com/lxnte/atlas-launcher/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}